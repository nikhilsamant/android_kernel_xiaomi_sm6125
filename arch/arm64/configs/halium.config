# Halium 11 / Ubuntu Touch kernel requirements.
# Merged as a fragment ON TOP of the LineageOS base + device fragments:
#   vendor/trinket-perf_defconfig vendor/xiaomi-trinket.config \
#   vendor/laurel_sprout.config halium.config

# --- hybris-boot init-script / udev ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y

# --- namespaces: required by the LXC Android container ---
CONFIG_NAMESPACES=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y

# --- cgroups: systemd + LXC device/pid control ---
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y

# --- systemd requirements ---
CONFIG_AUTOFS4_FS=y
CONFIG_FANOTIFY=y
CONFIG_INOTIFY_USER=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y

# --- AppArmor: mandatory for Ubuntu Touch app confinement.
# SECURITY_APPARMOR selects AUDIT, SECURITY_PATH, SECURITYFS, SECURITY_NETWORK.
# DEFAULT_SECURITY_APPARMOR flips the CONFIG_LSM default so apparmor is ordered
# BEFORE selinux -- the first exclusive LSM in that list wins (security.c:140),
# so without it AppArmor is compiled in but silently never activates.
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_SECURITY_APPARMOR_HASH_DEFAULT=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
# CONFIG_LSM must be set explicitly: the defconfig step materialises this string
# into .config BEFORE apparmor is enabled, so the "if DEFAULT_SECURITY_APPARMOR"
# Kconfig default never gets re-evaluated by the later oldconfig pass.
CONFIG_LSM="lockdown,yama,loadpin,safesetid,integrity,apparmor,selinux,smack,tomoyo,bpf"
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y

# --- console ---
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# --- filesystems ---
CONFIG_NLS_UTF8=y
CONFIG_OVERLAY_FS=y

# fscrypt, for Ubuntu Touch device encryption (FilesystemEncryption: true in the
# deviceinfo yaml, /etc/fscrypt.conf in the port repo). Already selected here by
# CONFIG_F2FS_FS_ENCRYPTION=y in vendor/xiaomi-trinket.config, and ext4's fscrypt
# code is guarded on CONFIG_FS_ENCRYPTION too -- so this line changes nothing
# today. It is stated explicitly because the reference ports do (fp4's
# ubports_fp4_defconfig sets CONFIG_FS_ENCRYPTION=y directly) and because the
# implicit select would disappear if F2FS were ever dropped from the base config.
CONFIG_FS_ENCRYPTION=y

# --- Waydroid: a second binder domain for the Android-in-a-container runtime.
#
# Waydroid runs its OWN Android userspace alongside the Halium one, so it needs
# binder devices of its own: /dev/binder, /dev/hwbinder and /dev/vndbinder are
# already claimed by the Halium container's servicemanager and hwservicemanager.
#
# waydroid's tools/helpers/drivers.py:setupBinderNodes() only allocates nodes
# itself when vendor_type == "MAINLINE". On a Halium port vendor_type is
# HALIUM_11, and that branch scans BINDER_DRIVERS[:-1] -- the candidate list with
# plain "binder" sliced off, leaving only "anbox-binder", "puddlejumper" and
# "bonder". It never creates them, so when the kernel exports no such node
# "waydroid init" aborts before it downloads anything:
#
#   ERROR: Binder node "binder" for waydroid not found
#     File "tools/helpers/drivers.py", line 155, in setupBinderNodes
#
# That is precisely what /var/lib/waydroid/waydroid.log records on this device,
# and why the Waydroid helper app sits forever on "preparing to download system
# image": there is nothing to download yet, init never got that far.
#
# CONFIG_ANDROID_BINDER_DEVICES defaults to "binder,hwbinder,vndbinder"
# (drivers/android/Kconfig:38) and neither the LineageOS base nor any device
# fragment overrides it, so the running kernel exports only those three. The old
# Halium 9 Lune kernel for this same device DID carry the anbox nodes
# (vendor/lune_defconfig:5134), and the FP4 reference port sets the identical
# string in ubports_fp4_defconfig -- so this restores parity with both.
#
# No userspace change is needed to expose them: CONFIG_ANDROID_BINDERFS=y is
# already set by vendor/trinket-perf_defconfig, so the nodes are created inside
# the binderfs instance at mount time, and mount-android-partitions symlinks them
# into /dev with a glob ("ln -s /dev/binderfs/*binder /dev") that already matches
# all three anbox-* names. The 70-android.rules 0666 lines cover only the Halium
# trio; FP4 likewise adds no anbox rules, and its Waydroid works.
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder,anbox-binder,anbox-hwbinder,anbox-vndbinder"

# NB: CONFIG_SQUASHFS is deliberately NOT enabled here, even though both
# lune_defconfig and the FP4 defconfig set it. The images Waydroid actually
# fetches are ext4 -- verified by inflating the zip headers straight from the OTA
# server: lineage-20.0 VANILLA system.img and lineage-18.1 HALIUM_11 vendor.img
# both carry the 0xef53 ext4 superblock magic at offset 0x438. mount.py mounts
# them with no "-t" and lets the kernel autodetect, so ext4 (already =y) is all
# that is required. Revisit only if a future image ships compressed.

# --- Waydroid networking: the iptables CHECKSUM target.
#
# waydroid-net.sh:98 is the last rule of start_iptables():
#
#   iptables -t mangle -A POSTROUTING -o waydroid0 -p udp -m udp --dport 68 \
#            -j CHECKSUM --checksum-fill
#
# It fixes up UDP checksums on DHCP replies to the container, whose virtio-style
# path leaves them blank. The target lives in net/netfilter/xt_CHECKSUM.c and is
# built only by NETFILTER_XT_TARGET_CHECKSUM, which is unset in the LineageOS
# base and in every device fragment. Without it the rule is rejected:
#
#   Warning: Extension CHECKSUM revision 0 not supported, missing kernel module?
#   iptables: No chain/target/match by that name.
#   Failed to setup waydroid-net.
#
# start_iptables() returns non-zero, container_manager.py:142 raises, and the
# session dies before the container ever boots -- so Waydroid installs fine and
# then simply never launches. This is the same shape of gap as the anbox binder
# nodes above: the FP4 defconfig sets it, and so did this device's own Halium 9
# Lune kernel (vendor/lune_defconfig).
#
# Nothing else in that script is missing: the mangle and nat tables, MASQUERADE,
# BRIDGE and VETH are all already =y, and the ip6tables MASQUERADE rule is gated
# behind LXC_IPV6_NAT="false" (waydroid-net.sh:33) so IP6_NF_NAT is not reachable.
# The remaining FP4-vs-here netfilter deltas -- BRIDGE_NETFILTER,
# XT_MATCH_ADDRTYPE, XT_MATCH_IPVS -- are not referenced by waydroid-net.sh at
# all and are deliberately left alone.
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y

# --- must be OFF ---
# Android hardening; blocks the usermode helpers Ubuntu Touch relies on
# CONFIG_STATIC_USERMODEHELPER is not set
# CONFIG_DUMMY is not set

# --- Bluetooth profiles: audio/headset (RFCOMM), keyboards & mice (HIDP),
# and network tethering (BNEP). CONFIG_BT is already on in the Lineage base;
# these profiles are not, so without them BT pairs but carries no usable service.
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y

# --- Virtual HCI: required by bluebinder, which proxies the Android binder
# Bluetooth HAL into BlueZ by opening /dev/vhci. Without it bluebinder exits
# with ENODEV ("Error: 19 (No such device)") and systemd restarts it about once
# a second forever. The FP4 reference port sets this as well
# (ubports_fp4_defconfig), on the same WCN3990 combo chip.
CONFIG_BT_HCIVHCI=y

# --- Opportunistic sleep. Without this the device NEVER suspends.
#
# repowerd is Ubuntu Touch's power daemon and it carries Android's libsuspend
# compiled in -- the binary contains the literal strings "/sys/power/autosleep",
# "autosleep_detect", "/sys/power/wake_lock" and "/sys/power/wakeup_count", and
# links no libsuspend.so of its own. libsuspend's init probes
# /sys/power/autosleep first, and that node only exists with PM_AUTOSLEEP.
#
# Neither the LineageOS base nor any device fragment sets it (PM_AUTOSLEEP is
# "default n" in kernel/power/Kconfig), so on the running kernel the node is
# absent and repowerd logs, at startup:
#
#   DefaultDaemonConfig: Failed to create LibsuspendSystemPowerControl:
#                        Failed to initialize libsuspend
#   DefaultDaemonConfig: Trying LogindSystemPowerControl
#
# The logind fallback manages the display but does not do wakelock-driven
# opportunistic sleep, and the result is measurable: after 3h35m of uptime,
# /sys/power/suspend_stats/success was 0. The phone had never once suspended.
# Cores do power-collapse in idle (cpuidle C1 held ~86% of wall time, and
# lpm_levels.sleep_disabled reads N), but the system never leaves the awake
# state, so the RPM never reaches XO shutdown or VDD-min and every subsystem
# stays powered -- including the MPSS that device-hacks deliberately holds up
# for Wi-Fi.
#
# The other half of the interface is /sys/power/wake_lock, from PM_WAKELOCKS.
# vendor/trinket-perf_defconfig does carry CONFIG_PM_WAKELOCKS=y, but it does
# not survive the fragment merge: the built kernel reads
# "# CONFIG_PM_WAKELOCKS is not set" while PM_AUTOSLEEP=y, so the node is
# absent and every write to it returns EACCES. vendor.per_mgr logs
# "MAIN_MGR: failed to hold/release wakelock, rc = -13" roughly twice a second
# because of it. Set it here explicitly rather than relying on inheritance, and
# re-check with `zcat /proc/config.gz | grep PM_WAKELOCKS` after flashing.
#
# Whether this alone is sufficient has to be confirmed by re-reading repowerd's
# log after flashing: if libsuspend still fails to initialise, the next thing to
# check is the wakeup_count fallback path (/sys/power/wakeup_count and
# /sys/power/state, both present and both mode 0660 system:system).
CONFIG_PM_AUTOSLEEP=y
CONFIG_PM_WAKELOCKS=y

# --- RPM sleep statistics. Diagnostic, but the only way to see whether suspend
# is actually saving power.
#
# With CONFIG_PM_AUTOSLEEP=y above, the device now suspends: measured 30819s of
# 36987s uptime spent suspended, 83.3%. Yet the overnight drain only improved
# from 1% per 13.6min to 1% per 16.3min -- roughly six times worse than a phone
# that sleeps properly. So suspend is being *entered* without the SoC reaching a
# low-power state, and nothing in /sys exposes that today.
#
# QTI_RPM_STATS_LOG builds drivers/soc/qcom/rpm_stats.o, which reads the RPM's
# own accounting out of SMEM and publishes it (count of times the system entered
# VDD-min / XO shutdown, and total time spent there). That is the direct answer
# to "did the SoC actually sleep, or did it just freeze userspace". Without it
# the question can only be inferred from battery current.
#
# The likely culprits are subsystems that never power down -- modem, cdsp and
# venus were all ONLINE with the screen off, and device-hacks pins the MPSS on
# purpose for Wi-Fi -- but that is a hypothesis until the RPM numbers can be
# read.
#
# QTI_RPM_STATS_LOG is "depends on DEBUG_FS" (drivers/soc/qcom/Kconfig), and
# trinket-perf_defconfig leaves DEBUG_FS off, so setting it alone was a no-op:
# the built kernel carried no QTI_RPM_STATS_LOG line at all -- not "is not set",
# absent, because the symbol was never visible. Verified on
# 4.14.357-openela-perf-g5f96db6fe6bd. DEBUG_FS also brings back
# /sys/kernel/debug/suspend_stats and /sys/kernel/debug/wakeup_sources, both of
# which are missing today (debugfs is not even mounted), so this one symbol is
# what makes the whole suspend story observable.
CONFIG_DEBUG_FS=y
CONFIG_QTI_RPM_STATS_LOG=y

# Note on CONFIG_QCOM_SHOW_RESUME_IRQ, which is already =y in the built kernel:
# an earlier comment here claimed the IRQ that wakes the device could be logged
# at runtime with
#     echo 1 > /sys/module/msm_show_resume_irq/parameters/debug_mask
# "without any rebuild". That is wrong in practice -- the node is 0664
# *root:root*, so phablet gets EACCES and sudo wants a password. Every resume
# logs "Resume cause unknown" until there is a root shell. Unprivileged
# substitute: /sys/class/wakeup/wakeup*/{name,event_count,active_count,
# total_time_ms,prevent_suspend_time_ms}, which is world-readable.

# --- Yama: prevents user processes from ptracing each other ---
CONFIG_SECURITY_YAMA=y

# --- Allow toggling SELinux from the kernel cmdline (selinux=0).
# AppArmor already claims the exclusive LSM slot via CONFIG_LSM ordering above;
# this is a diagnostic escape hatch, not the primary mechanism.
# NB: SECURITY_SELINUX_BOOTPARAM_VALUE no longer exists in this tree (removed
# upstream in 5.1); selinux_enabled_boot defaults to 1 in hooks.c and is only
# changed by passing selinux=0 on deviceinfo_kernel_cmdline.
CONFIG_SECURITY_SELINUX_BOOTPARAM=y

# --- Virtual framebuffer: required by the existing
# "video=vfb:640x400,bpp=32,memsize=3072000" kernel cmdline.
# The old Halium 9 Lune kernel set this; the LineageOS base does NOT, so without
# it that cmdline argument is silently a no-op.
CONFIG_FB_VIRTUAL=y

# --- Drop the IKHEADERS archive (/sys/kernel/kheaders.tar.xz).
# trinket-perf_defconfig sets CONFIG_IKHEADERS=y. It exists so BPF/bcc tooling
# can compile against the running kernel's headers; nothing in Ubuntu Touch
# uses it.
# Building it runs kernel/gen_kheaders.sh, which (a) invokes pushd/popd -- bash
# builtins -- via $(CONFIG_SHELL), so it exits 127 wherever that resolves to
# dash, and (b) forks one perl process per header over ~20k files, which is
# punishingly slow in the x86_64 build container under emulation.
# CONFIG_IKHEADERS is not set


# --- RNDIS gadget function, for USB networking (SSH over USB).
CONFIG_USB_CONFIGFS_RNDIS=y
